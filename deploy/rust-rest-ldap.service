[Unit]
Description=Rust REST LDAP directory server
Documentation=https://github.com/alexey-vostrikov/rust-rest-ldap
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rust-rest-ldap
Group=rust-rest-ldap
ExecStart=/usr/local/bin/rust-rest-ldap -c /etc/rust-rest-ldap/config.yaml

# The first administrator's password lives here, not in the unit: `systemctl show` prints
# Environment= to any user, and a password in it is a password published.
EnvironmentFile=-/etc/rust-rest-ldap/secrets.env

Restart=on-failure
RestartSec=5s

# The server finishes the operation it is in the middle of before it goes away, so this
# has to be longer than the grace period in the configuration.
KillSignal=SIGTERM
TimeoutStopSec=30s

# State: the entry store and the change journal. Created and owned by systemd, so the
# service needs no privilege to make them.
StateDirectory=rust-rest-ldap
StateDirectoryMode=0750

# Hardening. The server listens on two sockets and writes one database; everything else it
# is allowed to reach is named below.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/rust-rest-ldap
# Certificates are only read; keeping them under /etc needs the one path below.
ReadOnlyPaths=/etc/rust-rest-ldap

# A directory server without an open file limit is a server that fails at load: each
# client connection is a descriptor, and the default of 1024 arrives quickly.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
